---
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

// Screenshots of each live project live in src/assets/images/work/<slug>.webp (captured at 2x, 2048 px wide).
// A project without a screenshot yet still gets a row, with a plain tile and no hover preview.
const shots = import.meta.glob<{ default: ImageMetadata }>('../assets/images/work/*.webp', { eager: true });
const shot = (slug: string) => shots[`../assets/images/work/${slug}.webp`]?.default;

// Newest first.
const projects: { slug: string; title: string; alt: string; year?: number; url: string }[] = [
	{ slug: 'alexrenew', title: 'AlexRenew', alt: 'AlexRenew homepage with a technician servicing plant pipework', year: 2026, url: 'https://www.alexrenew.com/' },
	{ slug: 'comed-feature', title: 'The Efficient Home, Issue 2 Feature, ComEd', alt: 'ComEd Efficient Home feature page, “Every Neighbor Has a Story”', year: 2026, url: 'https://comed.theefficienthome.com/issue2/feature.html' },
	{ slug: 'bge-issue5', title: 'The Efficient Home, Issue 5, BGE', alt: 'Efficient Home Issue 5 cover story with a father and son gardening', year: 2026, url: 'https://bge.theefficienthome.com/issue5/' },
	{ slug: 'jerseyready', title: 'Jersey Ready, PSEG', alt: 'Jersey Ready homepage video still of a home at dusk', year: 2025, url: 'https://njready.com/' },
	{ slug: 'comeonin', title: 'Come On In Campaign, BGE', alt: 'Come On In campaign homepage with colorful Baltimore rowhouses', year: 2025, url: 'https://bgesmartenergy.com/comeonin/index.html' },
	{ slug: 'dallas', title: 'Dallas Street to Home Initiative', alt: 'Dallas Street to Home interactive overview with section navigation', year: 2025, url: 'https://www.icfcreative.com/2025/HUD/Dallas/index.html' },
	{ slug: 'hud-pp', title: 'Project Profiles, HUD', alt: 'HUD project profile for the Aurora Arts Center in Aurora, Illinois', year: 2024, url: 'https://www.hudexchange.info/programs/section-108/project-profiles/' },
	{ slug: 'dccps24', title: 'Div of Cancer Control, National Cancer Institute', alt: '2024 cancer control highlights title page, “Putting the National Cancer Plan into Action”', year: 2024, url: 'https://cancercontrol.cancer.gov/overview-highlights/2024/' },
	{ slug: 'rise', title: 'RISE Homes', alt: 'RISE Homes homepage, “Building back California smarter”', year: 2024, url: 'https://www.icfcreative.com/2024/RISE/v7/index-v2.html' },
	{ slug: 'dtt', title: 'DTT Interactive', alt: 'Hexavalent Chromium interactive title screen with a hexagon pattern', year: 2024, url: 'https://www.icfcreative.com/2024/DTT/NIEHS/index.html' },
	{ slug: 'dccps23', title: 'Div of Cancer Control, National Cancer Institute', alt: '2023 cancer control highlights with an illustrated mountain', year: 2023, url: 'https://cancercontrol.cancer.gov/overview-highlights/2023/' },
	{ slug: 'refresh', title: 'We hit refresh, PSEG', alt: 'PSEG brand hub, “We hit refresh”, with a worker on a rooftop at sunset', year: 2023, url: 'https://brandhub.pseg.com/public/index.html' },
];

// Earlier issues of the magazine, listed under Issue 5 rather than as rows of their own.
const archive = [
	{ slug: 'bge-issue4', label: 'Issue 4', year: 2025, url: 'https://bge.theefficienthome.com/issue4/' },
	{ slug: 'bge-issue3', label: 'Issue 3', year: 2024, url: 'https://bge.theefficienthome.com/issue3/' },
	{ slug: 'bge-issue2', label: 'Issue 2', year: 2023, url: 'https://bge.theefficienthome.com/issue2/' },
	{ slug: 'bge-issue1', label: 'Issue 1', year: 2022, url: 'https://bge.theefficienthome.com/issue1/' },
];

const previewOf = async (slug: string) => {
	const src = shot(slug);
	if (!src) return undefined;
	// The card is at most 512 CSS px wide, so 1024 px covers 2x screens.
	return (await getImage({ src, width: Math.min(1024, src.width), format: 'webp', quality: 82 })).src;
};

const earlierIssues = await Promise.all(archive.map(async (a) => ({ ...a, preview: await previewOf(a.slug) })));

const items = await Promise.all(
	projects.map(async (p) => {
		const src = shot(p.slug);
		return { ...p, src, preview: await previewOf(p.slug) };
	}),
);
---

<section class="work">
	{items.map((p) => (
		<div class="item">
			<a href={p.url} target="_blank" rel="noopener" data-preview={p.preview}>
				<div class="group">
					<div class="photo">
						{p.src && <Image src={p.src} width={Math.min(150, p.src.width)} alt={p.alt} />}
					</div>
					<div class="descrip">{p.title}</div>
					<div class="year">{p.year}</div>
				</div>
			</a>
			{p.slug === 'bge-issue5' && (
				<div class="archive">
					<span class="archive-label">Earlier issues</span>
					<ul>
						{earlierIssues.map((a) => (
							<li>
								<a href={a.url} target="_blank" rel="noopener" data-preview={a.preview}>
									{a.label}<span class="archive-year">{a.year}</span>
								</a>
							</li>
						))}
					</ul>
				</div>
			)}
			<div class="line"></div>
		</div>
	))}
	<div class="work-preview" aria-hidden="true">
		<div class="work-preview-shadow"></div>
		<div class="work-preview-frame"></div>
	</div>
</section>
