---
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

// Screenshots of each live project live in src/assets/images/work/<slug>.webp (1500×800).
const shots = import.meta.glob<{ default: ImageMetadata }>('../assets/images/work/*.webp', { eager: true });
const shot = (slug: string) => shots[`../assets/images/work/${slug}.webp`].default;

// Newest first.
const projects = [
	{ slug: 'bge-issue5', title: 'The Efficient Home, Issue 5, BGE', year: 2026, url: 'https://bge.theefficienthome.com/issue5/' },
	{ slug: 'jerseyready', title: 'Jersey Ready, PSEG', year: 2025, url: 'https://njready.com/' },
	{ slug: 'comeonin', title: 'Come On In Campaign, BGE', year: 2025, url: 'https://bgesmartenergy.com/comeonin/index.html' },
	{ slug: 'dallas', title: 'Dallas Street to Home Initiative', year: 2025, url: 'https://www.icfcreative.com/2025/HUD/Dallas/index.html' },
	{ slug: 'bge-issue4', title: 'The Efficient Home, Issue 4, BGE', year: 2025, url: 'https://bge.theefficienthome.com/issue4/' },
	{ slug: 'bge-issue3', title: 'The Efficient Home, Issue 3, BGE', year: 2024, url: 'https://bge.theefficienthome.com/issue3/' },
	{ slug: 'hud-pp', title: 'Project Profiles, HUD', year: 2024, url: 'https://www.hudexchange.info/programs/section-108/project-profiles/' },
	{ slug: 'dccps24', title: 'Div of Cancer Control, National Cancer Institute', year: 2024, url: 'https://cancercontrol.cancer.gov/overview-highlights/2024/' },
	{ slug: 'rise', title: 'RISE Homes', year: 2024, url: 'https://www.icfcreative.com/2024/RISE/v7/index-v2.html' },
	{ slug: 'dtt', title: 'DTT Interactive', year: 2024, url: 'https://www.icfcreative.com/2024/DTT/NIEHS/index.html' },
	{ slug: 'bge-issue2', title: 'The Efficient Home, Issue 2, BGE', year: 2023, url: 'https://bge.theefficienthome.com/issue2/' },
	{ slug: 'hud-info', title: 'HUD Infographic', year: 2023, url: 'https://www.icfcreative.com/2023/HUD/buildforfuture/index.html' },
	{ slug: 'dccps23', title: 'Div of Cancer Control, National Cancer Institute', year: 2023, url: 'https://cancercontrol.cancer.gov/overview-highlights/2023/' },
	{ slug: 'refresh', title: 'We hit refresh, PSEG', year: 2023, url: 'https://brandhub.pseg.com/public/index.html' },
	{ slug: 'bge-issue1', title: 'The Efficient Home, Issue 1, BGE', year: 2022, url: 'https://bge.theefficienthome.com/issue1/' },
	{ slug: 'nyc', title: 'NYC Accelerator, NYC', year: 2022, url: 'https://accelerator.nyc/' },
];

const items = await Promise.all(
	projects.map(async (p) => {
		const src = shot(p.slug);
		const preview = await getImage({ src, width: Math.min(1200, src.width), format: 'webp' });
		return { ...p, src, preview: preview.src };
	}),
);
---

<section class="work">
	{items.map((p) => (
		<div class="item">
			<a href={p.url} target="_blank" rel="noopener">
				<div class="group">
					<div class="photo">
						<Image src={p.src} width={Math.min(150, p.src.width)} alt="" data-preview={p.preview} />
					</div>
					<div class="descrip">{p.title}</div>
					<div class="year">{p.year}</div>
				</div>
			</a>
			<div class="line"></div>
		</div>
	))}
	<div class="work-preview" aria-hidden="true"><img alt="" /></div>
</section>
