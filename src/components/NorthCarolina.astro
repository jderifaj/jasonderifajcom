---
/**
 * North Carolina, overprinted on the portrait the way Max Huber laid flat spot-color
 * shapes over photographs: an outline and a truss lattice like his oil derrick.
 *
 * The lattice is real line segments rather than a pattern, so src/scripts/state.js
 * can draw them one by one.
 */
import { northCarolina } from '../data/north-carolina';
import { buildLattice } from '../lib/lattice';

const { viewBox, path } = northCarolina;
const [, , width, height] = viewBox.split(' ').map(Number);

const lattice = buildLattice({ path, width, height, cell: 96, rotate: -14 });
---
<svg class="state" viewBox={viewBox} aria-hidden="true" focusable="false">
	<defs>
		<clipPath id="state-clip">
			<path d={path} />
		</clipPath>
	</defs>

	<g class="state-truss" clip-path="url(#state-clip)">
		{lattice.map(({ x1, y1, x2, y2, from, to }) => (
			<line x1={x1} y1={y1} x2={x2} y2={y2} pathLength="1" data-from={from} data-to={to} />
		))}
	</g>
	<path class="state-line" d={path} />
</svg>
