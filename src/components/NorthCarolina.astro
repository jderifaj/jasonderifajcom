---
/**
 * North Carolina, overprinted on the portrait the way Max Huber laid flat spot-color
 * shapes over photographs: a translucent fill, a truss lattice like his oil derrick,
 * and an outline printed slightly out of register.
 */
import { northCarolina } from '../data/north-carolina';

const { viewBox, path } = northCarolina;
---
<svg class="state" viewBox={viewBox} aria-hidden="true" focusable="false">
	<defs>
		<clipPath id="state-clip">
			<path d={path} />
		</clipPath>
		<pattern id="state-truss" width="96" height="96" patternUnits="userSpaceOnUse" patternTransform="rotate(-14)">
			<path class="state-truss-line" d="M0 0H96V96H0ZM0 0L96 96M96 0L0 96" />
		</pattern>
	</defs>

	<path class="state-fill" d={path} />
	<rect class="state-truss" width="100%" height="100%" fill="url(#state-truss)" clip-path="url(#state-clip)" />
	<path class="state-line" d={path} />
</svg>
