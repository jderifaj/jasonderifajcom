---
/**
 * The home page poster, set on a 12-column grid, in overlapping planes on white: deep green on
 * the left, a navy plane from column 6 to the right edge that carries the route map, and an
 * emerald plane under the foot of the left side. The map runs on behind the copy and under the name. The name is
 * the anchor: huge, sitting on the bottom edge and cropped by it and by the right edge, it
 * crosses from the emerald plane onto the navy one. Title, intro and contacts hold columns 1
 * to 5 above it; Work and Words sit at the top right.
 */
import NorthCarolina from './NorthCarolina.astro';
import RouteMap from './RouteMap.astro';
import { posterMap, routeGeometry } from '../data/route';

const contacts = [
	{ kind: 'Email', label: 'jderifaj@gmail.com', href: 'mailto:jderifaj@gmail.com' },
	{ kind: 'GitHub', label: 'github.com/jderifaj', href: 'https://github.com/jderifaj', rel: 'me' },
	{ kind: 'LinkedIn', label: 'linkedin.com/in/jason-derifaj', href: 'https://www.linkedin.com/in/jason-derifaj-b219a72', rel: 'me' },
];

const tiles = [
	{ panel: 'work', index: '01', title: 'Work', label: 'Curated projects' },
	{ panel: 'recommendations', index: '02', title: 'Words', label: 'Recommendations' },
];

const name = ['Jason', 'Derifaj'];

const disciplines = ['Design systems', 'Interaction', 'Accessibility'];
---
<section class="poster" aria-labelledby="poster-name">
	<div class="poster-ground" aria-hidden="true"></div>
	<div class="poster-block" aria-hidden="true"></div>
	<div class="poster-plane" aria-hidden="true"></div>

	<div class="masthead">
		<p class="credit">Design &amp; code: Jason Derifaj</p>

		<nav class="tiles" aria-label="Portfolio">
			{tiles.map(({ panel, index, title, label }) => (
				<button
					class="tile"
					type="button"
					commandfor={panel}
					command="show-modal"
					aria-haspopup="dialog"
					data-open={panel}
				>
					<span class="tile-head">
						<span class="tile-title">{title}</span>
						<span class="tile-index" aria-hidden="true">{index}</span>
					</span>
					<span class="tile-label"><span class="visually-hidden">: </span>{label}</span>
				</button>
			))}
		</nav>
	</div>

	<div class="band">
		<div class="band-title">
			{/* Screen readers get the name whole. It's drawn twice: in black underneath, then in mint,
			    which src/scripts/intro.js uncovers as the planes rise behind it. */}
			<h1 id="poster-name" class="name">
				<span class="visually-hidden">{name.join(' ')}</span>
				<span class="name-ink" aria-hidden="true">{name.join(' ')}</span>
				<span class="name-fill" aria-hidden="true">{name.join(' ')}</span>
			</h1>
			<p class="role">Senior Creative Front-End Engineer</p>
			<p class="disciplines">
				{disciplines.map((discipline, i) => (
					<>{i > 0 && <span class="disciplines-slash" aria-hidden="true">/</span>}<span>{discipline}</span></>
				))}
			</p>
		</div>
	</div>

	<div
		class:list={['copy', { 'copy--route': posterMap === 'route' }]}
		style={posterMap === 'route'
			? `--route-ratio: ${routeGeometry.ratio.toFixed(4)}; --route-start: ${routeGeometry.start.toFixed(4)}; --route-top-stop: ${routeGeometry.topStop.toFixed(4)}; --route-bottom-stop: ${routeGeometry.bottomStop.toFixed(4)}; --route-reach: ${routeGeometry.reach.toFixed(4)}`
			: undefined}
	>
		{posterMap === 'route' ? (
			<RouteMap />
		) : (
			<NorthCarolina />
		)}

		<p class="poster-meta">
			Interactive developer blending animation and design to tell compelling stories on the web
			— résumé on request — #creativefrontend —
		</p>
		<ul class="poster-contact" aria-label="Contact">
			{contacts.map(({ kind, label, href, rel }) => (
				<li>
					<span class="contact-kind">{kind}</span>
					<a href={href} rel={rel}>{label}<span class="contact-arrow" aria-hidden="true">{href.startsWith('mailto:') ? '→' : '↗'}</span></a>
				</li>
			))}
		</ul>
	</div>

	<p class="copyright">&copy; {new Date().getFullYear()}</p>
</section>
