---
/**
 * The route map: Athens, GA → Cary, NC → Richmond, VA → Washington, DC, drawn like a technical
 * diagram: the route's states in hairline, crosshairs at each whole degree of latitude and
 * longitude, and one line for the route. src/scripts/route.js draws it in: the states, then
 * each leg of the route.
 *
 * Every label sits on one vertical axis through Athens, the first stop, and hangs off a leader
 * with a 90° elbow: Athens' drops straight down to its label, the others rise from their dot
 * and turn left to theirs. Dots, leaders and labels are HTML laid over the map, so they keep
 * their size. Each label is numbered in route order and names its city; under the city, a line
 * steps through what happened there, then lands on what I do there as the route moves on. The
 * finished map shows the city and what I do; screen readers hear all three.
 */
import { eastCoast, frame, project } from '../data/east-coast';
import { stops } from '../data/route';

const { viewBox, states } = eastCoast;
const [, , width, height] = viewBox.split(' ').map(Number);

const points = stops.map((stop) => ({ ...stop, ...project(stop.lat, stop.lon) }));

/** Each leg is one gentle curve. */
const BOW = 0.06;
const legs = points.slice(1).map((to, leg) => {
	const from = points[leg];
	const [dx, dy] = [to.x - from.x, to.y - from.y];
	// Control point: the midpoint, pushed sideways by a share of the leg's length.
	const cx = (from.x + to.x) / 2 - dy * BOW;
	const cy = (from.y + to.y) / 2 + dx * BOW;
	return { leg, d: `M${from.x.toFixed(1)} ${from.y.toFixed(1)}Q${cx.toFixed(1)} ${cy.toFixed(1)} ${to.x.toFixed(1)} ${to.y.toFixed(1)}` };
});


const pct = (v: number, of: number) => `${((v / of) * 100).toFixed(3)}%`;

/** The label axis, through Athens, and each stop's distance from it as a share of the map's width. */
const axis = points[0].x;
const fromAxis = (x: number) => (((x - axis) / width) * 100).toFixed(3);

// The latitude and longitude grid: a crosshair where whole degrees cross, and the coordinates
// of one crossing, written to its left, out in the Atlantic.
const lats = Array.from({ length: Math.floor(frame.north) - Math.ceil(frame.south) + 1 }, (_, i) => Math.ceil(frame.south) + i);
const lons = Array.from({ length: Math.floor(frame.east) - Math.ceil(frame.west) + 1 }, (_, i) => Math.ceil(frame.west) + i);
const latY = (lat: number) => project(lat, frame.west).y;
const lonX = (lon: number) => project(frame.north, lon).x;
const CROSS = 4;
const crosses = lats
	.flatMap((lat) => lons.map((lon) => [lonX(lon), latY(lat)]))
	.map(([x, y]) => `M${(x - CROSS).toFixed(1)} ${y.toFixed(1)}h${CROSS * 2}M${x.toFixed(1)} ${(y - CROSS).toFixed(1)}v${CROSS * 2}`)
	.join('');
const marks = [{ lat: 34, lon: -76 }].map(({ lat, lon }) => ({ x: lonX(lon), y: latY(lat), text: `${lat}°N ${Math.abs(lon)}°W` }));
---
<div
	class="state state--route"
	data-route
	data-width={width}
	data-height={height}
>
	<svg class="route-map" viewBox={viewBox} aria-hidden="true" focusable="false">
		<g class="route-grid" data-depth="grid">
			<path class="route-cross" d={crosses} />
			{marks.map(({ x, y, text }) => (
				<text class="route-coord" x={x - 8} y={y + 16} text-anchor="end">{text}</text>
			))}
		</g>

		<g class="route-states" data-depth="states">
			{states.filter(({ core }) => core).map(({ path }) => (
				<path class="route-state" d={path} pathLength="1" />
			))}
		</g>

		<g class="route-legs">
			{legs.map(({ d, leg }) => (
				<path class="route-strand" d={d} pathLength="1" data-leg={leg} />
			))}
		</g>
	</svg>

	<ul class="stops" aria-label="Where I've worked, on site and remotely">
		{points.map(({ name, moments, role, x, y }, i) => (
			<li
				class="city stop"
				data-leader={i === 0 ? 'down' : 'up'}
				data-city={name}
				data-moments={JSON.stringify(moments)}
				data-role={role}
				style={`left: ${pct(x, width)}; top: ${pct(y, height)}; --from-axis: ${fromAxis(x)}`}
			>
				<span class="leader" aria-hidden="true"></span>
				<span class="city-dot" aria-hidden="true"></span>
				<span class="city-label">
					<span class="city-plate" aria-hidden="true"></span>
					<span class="city-index" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
					<span class="city-shine" aria-hidden="true"></span>
					<span class="city-name" aria-hidden="true">{name}</span>
					{/* Shows the role, the end state; route.js starts it blank, then steps through the moments */}
					<span class="city-text" aria-hidden="true">{role}</span>
					<span class="visually-hidden">{name}: {moments.join('. ')}. {role}</span>
					<span class="city-wipe" aria-hidden="true"></span>
				</span>
			</li>
		))}
	</ul>
</div>
