---
import Layout from '../layouts/Layout.astro';
import Panel from '../components/Panel.astro';
import Poster from '../components/Poster.astro';
import Recommendations from '../components/Recommendations.astro';
import WorkList from '../components/WorkList.astro';
---
<Layout
	title="Jason Derifaj — Senior Creative Front-End Engineer"
	description="Jason Derifaj is a senior creative front-end engineer who blends motion, design systems and fast, accessible code into websites that tell compelling stories."
>
	<main>
		<Poster />
	</main>

	<Panel id="work" title="Curated work">
		<WorkList />
	</Panel>

	<Panel id="recommendations" title="Recommendations from colleagues">
		<Recommendations />
	</Panel>
</Layout>

<script>
	import '../scripts/home.js';
</script>
