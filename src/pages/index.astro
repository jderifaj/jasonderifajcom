---
import Layout from '../layouts/Layout.astro';
import Poster from '../components/poster.astro';
import Work from '../components/work.astro';
import Comments from '../components/comments.astro';
---
<Layout
	title="Jason Derifaj — Creative Front-End Developer"
	description="Jason Derifaj is a creative front-end developer who blends motion, design systems and fast, accessible code into websites that tell compelling stories."
>
	<main>
		<Poster />
	</main>

	<dialog id="work" class="panel" aria-labelledby="work-title">
		<header class="panel-head">
			<h2 id="work-title">Curated work<span class="dash" aria-hidden="true"></span></h2>
			<button class="panel-close" type="button" commandfor="work" command="close" data-close>Close <span aria-hidden="true">×</span></button>
		</header>
		<div class="panel-body"><Work /></div>
	</dialog>

	<dialog id="words" class="panel" aria-labelledby="words-title">
		<header class="panel-head">
			<h2 id="words-title">Kind words<span class="dash" aria-hidden="true"></span></h2>
			<button class="panel-close" type="button" commandfor="words" command="close" data-close>Close <span aria-hidden="true">×</span></button>
		</header>
		<div class="panel-body"><Comments /></div>
	</dialog>
</Layout>
